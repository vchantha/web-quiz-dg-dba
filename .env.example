# Copy to .env and replace all placeholder secrets.
POSTGRES_DB=dba_quiz
POSTGRES_USER=dba_quiz
POSTGRES_PASSWORD=replace-with-strong-db-password
DJANGO_SECRET_KEY=replace-with-a-long-unique-random-secret-at-least-50-characters
DJANGO_DEBUG=0
# Literal server IP addresses (LAN or public) are allowed dynamically.
# Restrict domain names explicitly via DJANGO_ALLOWED_HOSTS.
QUIZ_ALLOW_IP_HOSTS=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,testserver
# Same-origin IP:8080 requests do not need an extra CSRF trusted-origin entry.
# For a custom HTTPS domain, list its full https:// URL here.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
QUIZ_HTTP_PORT=8080
QUIZ_MAX_ATTEMPTS=1
QUIZ_SHOW_ANSWER_REVIEW=0
SEED_DEMO_USERS=0
DEMO_ADMIN_PASSWORD=
DEMO_CANDIDATE_PASSWORD=
